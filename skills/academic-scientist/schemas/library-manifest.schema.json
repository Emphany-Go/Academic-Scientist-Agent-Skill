{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "original_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "enum": [
                    "main",
                    "supplement"
                  ]
                },
                "parent_doc_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "role",
                "parent_doc_id"
              ]
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "registered",
              "processing",
              "parsed_text",
              "review_required",
              "partial",
              "failed",
              "password_required"
            ]
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "parse_runs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "active_parse": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "sha256",
          "source_path",
          "original_paths",
          "roles",
          "status",
          "page_count",
          "parse_runs",
          "active_parse",
          "error"
        ]
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "parent_doc_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "supplied_doc_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "parent_doc_id",
          "label",
          "supplied_doc_id"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "time",
          "action",
          "detail"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "updated_at",
    "documents",
    "expectations",
    "events"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Scientist library-manifest v0.2.0"
}
